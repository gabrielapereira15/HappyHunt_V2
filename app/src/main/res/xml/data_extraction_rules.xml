<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and up: saved places and settings come along to a new phone. Where you searched from (datastore/places) and the search cache stay behind. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="saved.db" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="saved.db" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
